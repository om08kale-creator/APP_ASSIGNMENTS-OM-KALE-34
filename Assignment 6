def knapsack_01(capacity, weights, values):
    n = len(values)
    dp_table = [[0] * (capacity + 1) for _ in range(n + 1)]

    for i in range(1, n + 1):
        for w in range(1, capacity + 1):
            if weights[i - 1] <= w:
                include_item = values[i - 1] + dp_table[i - 1][w - weights[i - 1]]
                exclude_item = dp_table[i - 1][w]
                dp_table[i][w] = max(include_item, exclude_item)
            else:
                dp_table[i][w] = dp_table[i - 1][w]

    return dp_table[n][capacity]


item_values = [60, 100, 120]
item_weights = [10, 20, 30]
max_capacity = 50

max_profit = knapsack_01(max_capacity, item_weights, item_values)
print(f"Maximum value possible in the knapsack: {max_profit}")

