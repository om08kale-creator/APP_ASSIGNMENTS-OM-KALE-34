# Bank Customer Record System
# Reads customer records from customers.csv
# Uses Regular Expressions to validate Account Number

import csv
import re

# Read customer records from customers.csv
with open("customers.csv", "r", newline="") as file:
    reader = csv.DictReader(file)
    customers = list(reader)

# Display all customer details
print("\n--- All Customer Details ---")

for customer in customers:
    print("Account Number :", customer["Account Number"])
    print("Name           :", customer["Name"])
    print("Account Type   :", customer["Account Type"])
    print("Balance        :", customer["Balance"])
    print("Phone          :", customer["Phone"])
    print("-----------------------------")

# Accept account number
account_number = input("\nEnter Account Number to search: ")

# Regular Expression validation
# Account number format: ACC followed by 6 digits
pattern = r"^ACC[0-9]{6}$"

if not re.match(pattern, account_number):
    print("Invalid Account Number format.")
    print("Account number must be in the format ACC followed by 6 digits.")
else:
    # Search for the customer
    found = False

    for customer in customers:
        if customer["Account Number"] == account_number:
            print("\n--- Customer Found ---")
            print("Account Number :", customer["Account Number"])
            print("Name           :", customer["Name"])
            print("Account Type   :", customer["Account Type"])
            print("Balance        :", customer["Balance"])
            print("Phone          :", customer["Phone"])
            found = True
            break

    if not found:
        print("Customer not found.")


