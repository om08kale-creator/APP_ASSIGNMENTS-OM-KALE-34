class Player:
    def __init__(self, name, jersey_no, runs):
        self.name = name
        self.jersey_no = jersey_no
        self.runs = runs

def category(self):
        if self.runs >= 500:
            return "Excellent"
        elif self.runs >= 200:
            return "Good"
        else:
            return "Average"

    def display(self):
        print("Player Name   :", self.name)
        print("Jersey Number :", self.jersey_no)
        print("Runs Scored   :", self.runs)
        print("Category      :", self.category())
        print("-" * 30)


class Team:
    def __init__(self):
        self.players = []

    def add_player(self, player):
        self.players.append(player)

# Display all players
    def show_team(self):
        print("\n------ Team Players ------")
        for player in self.players:
            player.display()

team = Team()

n = int(input("Enter number of players: "))

for i in range(n):
    print("\nEnter details of Player", i + 1)
    name = input("Player Name: ")
    jersey = int(input("Jersey Number: "))
    runs = int(input("Runs Scored: "))
    p = Player(name, jersey, runs)
    team.add_player(p)
team.show_team()
